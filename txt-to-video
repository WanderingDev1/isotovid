import cv2
import numpy as np
import os

txt_filename = "iso_raw_dump.txt" # or whatever you renamed it too
video_filename = "txt_static_movie.mp4" # or whatever you want the name it to

width, height = 1280, 720
fps = 30
bytes_per_frame = width * height  

if not os.path.exists(txt_filename):
    print(f"Error: Could not find '{txt_filename}'")
else:
    print("Converting the text file into video frames...")
    

    fourcc = cv2.VideoWriter_fourcc(*'mp4v')
    video = cv2.VideoWriter(video_filename, fourcc, fps, (width, height), isColor=False)
    

    with open(txt_filename, "rb") as infile:
        while True:

            chunk = infile.read(bytes_per_frame)
            if not chunk:
                break # Stop when the text file ends
                

            if len(chunk) < bytes_per_frame:
                chunk += b'\x00' * (bytes_per_frame - len(chunk))
                

            frame = np.frombuffer(chunk, dtype=np.uint8).reshape((height, width))
            

            video.write(frame)
            
    video.release()
    print(f"Success! the video has been created: '{video_filename}'")
